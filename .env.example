# Copy to .env (git-ignored). Never commit .env.
GEMINI_API_KEY=
# The guide uses gemini-3.5-flash; change only if AI Studio lists a different free Flash model for your key.
GEMINI_MODEL=gemini-3.5-flash
# gemini (live) | offline (no key: deterministic stand-in for demos/tests)
LLM_PROVIDER=gemini
# st (paraphrase-multilingual-mpnet-base-v2, the course model) | hash (offline tests only)
EMBEDDER=st
# http (chroma run on :8000, the course setup) | persistent | memory
CHROMA_MODE=http
CHROMA_PORT=8000
# cosine distance cut-off for retrieved examples; tune after looking at retrieval_demo.py output
MAX_DISTANCE=0.6
# Bridge: localhost only + shared secret sent by the WhatsApp client
BRIDGE_URL=http://127.0.0.1:5001
BRIDGE_TOKEN=change-me-to-a-random-string
